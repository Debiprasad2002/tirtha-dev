# Example .env for backend email configuration (do NOT commit real secrets)
# Copy this file to backend/.env and fill the values, then restart the Django
# development server. Prefer exporting these variables in your environment.

# Django settings
# DJANGO_SECRET_KEY: a secure random secret key for production
# DJANGO_DEBUG: 'true' or 'false'
# DJANGO_ALLOWED_HOSTS: comma-separated hostnames for production
# CORS_ALLOWED_ORIGINS: comma-separated allowed frontend origins
# GOOGLE_OAUTH_CLIENT_ID: OAuth client ID used by Google sign-in
GOOGLE_OAUTH_CLIENT_ID=115708159411-q1lpeqtjehsfkbtpe3i6jtfog9p7qrdi.apps.googleusercontent.com

# Gmail SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your.account@gmail.com
# Use the 16-character App Password generated in Google Account -> Security -> App passwords
EMAIL_HOST_PASSWORD=your16characterapppassword

# Sender address used in emails
DEFAULT_FROM_EMAIL=your.account@gmail.com

# Optional: set to 'true' in production to use real SMTP; DEBUG still overrides
# console backend when DEBUG=true.